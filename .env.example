# Keys needed by Smart Job Finder.
# n8n stores these as credentials; this file only documents what you need.
# Never commit real values.

# OpenAI (OpenAI Deep Scoring)
OPENAI_API_KEY=

# JSearch via RapidAPI (sent as X-RapidAPI-Key header)
RAPIDAPI_KEY=

# SerpAPI (sent as api_key query parameter)
SERPAPI_API_KEY=

# Google OAuth client for Google Sheets and Gmail credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Sheet IDs
SEEN_JOBS_SHEET_ID=
RESUME_SHEET_ID=

# Where the job digest is emailed
NOTIFY_EMAIL=
